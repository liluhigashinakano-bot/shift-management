{
  "name": "shift-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint",
    "verify": "npm test && npm run build",
    "test": "npm run test:login-email && npm run test:sheet-date && npm run test:google-form-config",
    "test:login-email": "npx tsx src/lib/login-email.test.ts",
    "test:sheet-date": "npx tsx src/lib/sheet-date.test.ts",
    "test:google-form-config": "npx tsx src/lib/google-form-config.test.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:push": "npx prisma db push",
    "db:reset": "npx prisma migrate reset --force",
    "docs:pdf": "node scripts/print-manual-pdf.mjs",
    "docs:pdf:cast": "node scripts/print-manual-pdf.mjs CAST_MANUAL.md CAST_MANUAL.pdf"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "marked": "^15.0.12",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
